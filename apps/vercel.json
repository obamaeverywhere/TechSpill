{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/((?!@|src/|node_modules/|assets/|.*\\.).*)",
          "destination": "/index.html"
        }
      ],
      "devCommand": "npm run dev -- --port $PORT"
    },
    "api": {
      "root": "api",
      "framework": "express",
      "entrypoint": "app.ts",
      "buildCommand": "cd ../.. && npm run db:generate"
    }
  },
  "daemons": {
    "worker": {
      "root": "..",
      "entrypoint": "Dockerfile.worker",
      "instances": {
        "iad1": 1
      },
      "resources": {
        "requests": {
          "memory": "1Gi"
        }
      },
      "terminationGracePeriodSeconds": 120
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
