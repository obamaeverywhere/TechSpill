DATABASE_URL=postgresql://techpulse:techpulse@localhost:5432/techpulse?schema=public
PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info
SERVE_WEB=false
TRUST_PROXY_HOPS=0
WORKER_STALE_MINUTES=30
COLLECTION_CRON=*/10 * * * *
COLLECTION_CONCURRENCY=3
FETCH_TIMEOUT_MS=15000
FETCH_RETRIES=2
HN_STORY_LIMIT=35
TREND_FRESHNESS_WEIGHT=60
TREND_COVERAGE_WEIGHT=25
TREND_ENGAGEMENT_WEIGHT=15
# Optional licensed provider; remains on the backend. Check your plan's redistribution rights.
GNEWS_API_KEY=
GNEWS_DAILY_REQUEST_LIMIT=24
GNEWS_BD_LANGUAGE=en
# Leave empty for Vite proxy / same-origin hosting. Set to API origin for a separate frontend host.
VITE_API_URL=
VITE_REFRESH_INTERVAL_MS=60000
