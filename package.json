{
  "name": "techpulse",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web,worker -c blue,green,yellow \"npm run dev -w @techpulse/api\" \"npm run dev -w @techpulse/web\" \"npm run dev -w @techpulse/worker\"",
    "dev:web": "npm run dev -w @techpulse/web",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:local": "tsx scripts/local-postgres.ts",
    "collect": "tsx --env-file-if-exists=.env apps/worker/src/index.ts --once",
    "source:configure": "tsx --env-file-if-exists=.env scripts/configure-source.ts",
    "bd:review": "tsx --env-file-if-exists=.env scripts/bangladesh-review.ts",
    "build": "npm run db:generate && npm run typecheck && npm run build -w @techpulse/api && npm run build -w @techpulse/worker && npm run build -w @techpulse/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_DB_TESTS=1 vitest run --no-file-parallelism tests/integration.test.ts tests/bangladesh.integration.test.ts",
    "start:api": "node --env-file-if-exists=.env apps/api/dist/index.js",
    "start:worker": "node --env-file-if-exists=.env apps/worker/dist/index.js",
    "format": "prettier --write apps packages scripts tests *.json *.ts *.md *.yaml",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:browser:bd": "node scripts/verify-bangladesh-browser.mjs",
    "test:browser:techspill": "node scripts/verify-techspill-browser.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "dotenv": "^16.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "embedded-postgres": "^17.5.0-beta.15",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.56.1",
    "prettier": "3.6.2",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "6.4.5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "vite": "6.4.5"
  }
}
